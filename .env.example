# Environment Configuration for MP4 to MP3 Converter

# Runtime mode
NODE_ENV=development

# Public Base URL
APP_URL=http://localhost:3000

# Database Connections
MONGODB_URI=mongodb://localhost:27017/mp4tomp3
REDIS_URL=redis://localhost:6379

# Session Secret (Generate a strong 32+ character random string for production)
SESSION_SECRET=mp4-to-mp3-dev-session-secret-change-me-in-production-32chars

# Storage Driver: "local" (default) or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/storage

# S3 Configuration (Required if STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# FFmpeg and FFprobe Binaries (leave blank to auto-detect from node_modules or system PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Conversion Limits & Performance
MAX_UPLOAD_BYTES=524288000       # 500 MB upload limit
MAX_DURATION_SECONDS=3600        # Max media duration: 1 hour
CONVERSION_TIMEOUT_SECONDS=900   # 15 minutes timeout
WORKER_CONCURRENCY=2             # Parallel worker jobs
FFMPEG_THREADS=2                 # Threads per FFmpeg process
DEFAULT_BITRATE_KBPS=192

# File Retention Policy
GUEST_RETENTION_HOURS=24         # Guest files purged after 24 hours
USER_RETENTION_HOURS=168         # Registered user files purged after 7 days
INPUT_RETENTION_MINUTES=60       # Uploaded input deleted after 60 min if conversion completes
